# Public Sanity Configuration (read-only queries)
NEXT_PUBLIC_SANITY_PROJECT_ID=k21eb9nx
NEXT_PUBLIC_SANITY_DATASET=production

# Server-Only Credentials (NEVER expose to browser with NEXT_PUBLIC_)
# Required for persisting contact form submissions to Sanity CMS via /api/contact:
# Generate a token with Editor or Create permissions in sanity.io/manage -> API -> Tokens
SANITY_API_WRITE_TOKEN=

# Optional Server-Only Dialogflow SDK Credentials (if using server-side chat intents)
# DIALOGFLOW_CLIENT_EMAIL=
# DIALOGFLOW_PRIVATE_KEY=
# DIALOGFLOW_PROJECT_ID=
GOOGLE_GENERATIVE_AI_API_KEY=your_copied_gemini_api_key
