  "post": [
    {
      "_createdAt": "2024-04-06T15:23:41Z",
      "_id": "2df3ad0a-d6db-4ff3-a0fa-dd79d6f6551b",
      "_rev": "DbTqvdcGi910mcIsEmtSeQ",
      "_type": "post",
      "_updatedAt": "2024-04-06T15:23:41Z",
      "content": [
        {
          "_key": "0b2688f1b06a",
          "_type": "block",
          "children": [
            {
              "_key": "e85b774e88450",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Introduction"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "76715d57c1d0",
          "_type": "block",
          "children": [
            {
              "_key": "b4e41ed4b58a0",
              "_type": "span",
              "marks": [],
              "text": "Welcome to a day in my coding life! I'm a self-taught student who loves diving into the world of coding every day. Join me as I share how coding has become more than just a hobby—it's a part of my daily routine and a source of endless fascination."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "21d80a2f37dc",
          "_type": "block",
          "children": [
            {
              "_key": "ef20fbb79838",
              "_type": "span",
              "marks": [],
              "text": ""
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "e7f38f07d691",
          "_type": "block",
          "children": [
            {
              "_key": "deadfd46e0140",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Morning Routine"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "8ba427a678cb",
          "_type": "block",
          "children": [
            {
              "_key": "10d063ca200c0",
              "_type": "span",
              "marks": [],
              "text": "My day starts with a cup of coffee and a dive into coding. I work on different projects, fix any issues I encounter, and explore new ideas. It's like solving puzzles and creating something new every day."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "ece9081a45ea",
          "_type": "block",
          "children": [
            {
              "_key": "2a6ce3424dde",
              "_type": "span",
              "marks": [],
              "text": ""
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "cc136588722b",
          "_type": "block",
          "children": [
            {
              "_key": "a3434f670ae10",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Learning Time"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "341e7176baba",
          "_type": "block",
          "children": [
            {
              "_key": "eee7606d254f0",
              "_type": "span",
              "marks": [],
              "text": "In the middle of the day, I take a break to learn more about coding. I watch tutorials, take online courses, and read about the latest trends. Learning new things keeps me excited and helps me improve my coding skills."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "6d291bbdd32d",
          "_type": "block",
          "children": [
            {
              "_key": "d42b1e858a7f",
              "_type": "span",
              "marks": [],
              "text": ""
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "d806f7972b15",
          "_type": "block",
          "children": [
            {
              "_key": "c47aea0df0250",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Afternoon Coding Session"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "7e722c82f451",
          "_type": "block",
          "children": [
            {
              "_key": "94e92b2276dd0",
              "_type": "span",
              "marks": [],
              "text": "Back to coding in the afternoon! This is when I get really creative. I work on my own projects, try out new coding techniques, and sometimes collaborate with other coders online. It's like painting with code and bringing my ideas to life."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
